# xbox360_runtime_frame: the second frame tests/title swapped, as the
# presentation's screenshot (<ID>_SHOT_EVERY=1) saved it: its resolved
# 64x64 texture, A (red 44, green 33, blue 22) with B (88 77 66) in the
# 8x8 block at (8, 16).
set(_bmp "${DIR}/frame_00002.bmp")
if(NOT EXISTS "${_bmp}")
  message(FATAL_ERROR "${_bmp} was not saved")
endif()
# A little-endian unsigned field of `size` bytes at `offset`.
function(_field out offset size)
  file(READ "${_bmp}" _hex OFFSET ${offset} LIMIT ${size} HEX)
  set(_v 0)
  math(EXPR _last "${size} - 1")
  foreach(_i RANGE ${_last} 0 -1)
    math(EXPR _at "${_i} * 2")
    string(SUBSTRING "${_hex}" ${_at} 2 _byte)
    math(EXPR _v "(${_v} << 8) | 0x${_byte}")
  endforeach()
  set(${out} ${_v} PARENT_SCOPE)
endfunction()
_field(_data 10 4)
_field(_w 18 4)
_field(_h 22 4)
_field(_bpp 28 2)
if(NOT _w EQUAL 64 OR NOT _h EQUAL 64)
  message(FATAL_ERROR "the frame is ${_w}x${_h}, not 64x64 (bottom-up)")
endif()
math(EXPR _bytes "${_bpp} / 8")
math(EXPR _stride "(64 * ${_bytes} + 3) / 4 * 4")
# Pixel (x, y) as rrggbb; rows are stored bottom-up, pixels as B, G, R.
function(_pixel out x y)
  math(EXPR _at "${_data} + (63 - ${y}) * ${_stride} + ${x} * ${_bytes}")
  file(READ "${_bmp}" _hex OFFSET ${_at} LIMIT 3 HEX)
  string(SUBSTRING "${_hex}" 0 2 _b)
  string(SUBSTRING "${_hex}" 2 2 _g)
  string(SUBSTRING "${_hex}" 4 2 _r)
  set(${out} "${_r}${_g}${_b}" PARENT_SCOPE)
endfunction()
foreach(_case "0;0;443322" "63;63;443322" "8;16;887766" "15;23;887766" "16;16;443322" "8;24;443322"
              "7;16;443322")
  list(GET _case 0 _x)
  list(GET _case 1 _y)
  list(GET _case 2 _want)
  _pixel(_got ${_x} ${_y})
  if(NOT _got STREQUAL _want)
    message(FATAL_ERROR "pixel (${_x}, ${_y}) is ${_got}, not ${_want}")
  endif()
endforeach()
